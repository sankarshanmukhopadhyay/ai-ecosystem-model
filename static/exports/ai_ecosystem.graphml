    <node id="cluster_regulatory" yfiles.foldertype="group">
      <data key="d_graphics">
        <y:ProxyAutoBoundsNode>
          <y:Realizers active="0">
            <y:GroupNode>
              <y:Geometry width="280" height="350"/>
              <y:Fill color="#F8FAFC" transparent="false"/>
              <y:BorderStyle color="#CBD5E1" type="line" width="1.5"/>
              <y:NodeLabel alignment="right" autoSizePolicy="node_width" backgroundColor="#E2E8F0" fontSize="12" fontStyle="bold" modelName="internal" modelPosition="t">0. Jurisdictional, Capital &amp; Regulatory Sphere</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
              <y:State closed="false"/>
            </y:GroupNode>
          </y:Realizers>
        </y:ProxyAutoBoundsNode>
      </data>
      <graph id="cluster_regulatory:" edgedefault="directed">
        <node id="N_REGULATOR">
          <data key="d_cluster">cluster_regulatory</data>
          <data key="d_domains">governance</data>
          <data key="d_kind">statutory_authority</data>
          <data key="d_sublabel">EU AI Office &amp; national authorities, FTC/state AGs &amp; courts, BIS export controls, China CAC, UK &amp; APAC regulators</data>
          <data key="d_evolution"></data>
          <data key="d_vsm"></data>
          <data key="d_vsm_rec"></data>
          <data key="d_jurisdiction">Global</data>
          <data key="d_eu_role"></data>
          <data key="d_nist"></data>
          <data key="d_card_min">1.0</data>
          <data key="d_card_max">2.0</data>
          <data key="d_card_unit">jurisdictions</data>
          <data key="d_prop_enforcement_powers">EU: fines up to 7% of global turnover for prohibited practices (Art. 99), up to 3% for GPAI providers (Art. 101); US: ex-post enforcement, litigation, export-control sanctions; China: registration and licensing regimes; stop orders.</data>
          <data key="d_graphics">
            <y:ShapeNode>
              <y:Geometry width="230" height="75"/>
              <y:Fill color="#FFF1F0" transparent="false"/>
              <y:BorderStyle color="#F5222D" type="line" width="2.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content">Statutory &amp; Trade Authorities
(EU AI Office &amp; national authorities, FTC/state AGs &amp; courts, BIS export controls, China CAC, UK &amp; APAC regulators)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
